# Generated by Cargo
# will have compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# SWF debug symbols
*.swd

# Flash recovery files
RECOVER_*.fla

# Jetbrains tools (CLion, IntelliJ, etc)
/.idea

# Mac junk
.DS_Store

# A developers local Flash Player harness config
.flash_players.toml

# AQW diagnostic output - may contain the tester's login traffic, never commit
aqw-diagnostic/
aqw-retest/
diagnostic-*.csv
diagnostic-*.log
diagnostic-*.txt
*-memory.csv
*-windows-ram.csv
*-console.log
